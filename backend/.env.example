APP_NAME="CivCo BTP"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# -----------------------------------------------------------------------------
# Database (SQLite for local; MySQL/MariaDB recommended for production)
# -----------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=civco_btp
DB_USERNAME=root
DB_PASSWORD=

# Local SQLite alternative:
# DB_CONNECTION=sqlite
# DB_DATABASE=database/database.sqlite

# -----------------------------------------------------------------------------
# Mail (application defaults; each tenant can override SMTP in Superadmin)
# -----------------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# -----------------------------------------------------------------------------
# Initial Superadmin (used by db:seed / PlatformSuperAdminSeeder)
# Use an email that is not already a tenant administrator login.
# -----------------------------------------------------------------------------
SUPERADMIN_NAME="Super Admin"
SUPERADMIN_EMAIL=admin@civco.ma
SUPERADMIN_PASSWORD=ChangeThisPassword123!

# -----------------------------------------------------------------------------
# Sessions, cache, queue
# -----------------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=

CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local
BROADCAST_CONNECTION=log

SANCTUM_STATEFUL_DOMAINS=localhost,localhost:5173,127.0.0.1,127.0.0.1:5173

# -----------------------------------------------------------------------------
# Multi-tenant host routing
# -----------------------------------------------------------------------------
TENANCY_BASE_DOMAIN=monerp.com
TENANCY_SUBDOMAIN_ROUTING=false
TENANCY_LOGIN_SCHEME=http
TENANCY_LOGIN_PORT=8000
TENANCY_FRONTEND_PORT=5173
TENANCY_LOCAL_QUERY_FALLBACK=true
TENANCY_LOCAL_LOGIN_HOST=localhost
TENANCY_LOCAL_FRONTEND_HOST=127.0.0.1

# -----------------------------------------------------------------------------
# Optional microservices (leave empty to run in-process)
# -----------------------------------------------------------------------------
DOCUMENT_RENDERER_URL=
DOCUMENT_RENDERER_SECRET=
DOCUMENT_RENDERER_TIMEOUT=10

NOTIFICATION_DISPATCHER_URL=
NOTIFICATION_DISPATCHER_SECRET=
NOTIFICATION_DISPATCHER_TIMEOUT=10

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
